{
  "expo": {
    "name": "TuneMatch",
    "slug": "tunematch",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.paltech.tunematch",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#221019"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paltech.tunematch",
      "buildNumber": "65",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "TuneMatch needs access to your photo library so you can choose a photo to match with music. For example, pick a photo from a concert or a beach walk and TuneMatch analyzes its colors, light and scene to recommend songs that fit that moment."
      },
      "usesAppleSignIn": true,
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#221019"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.paltech.tunematch",
      "runtimeVersion": "1.0.0",
      "versionCode": 36
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#221019"
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "TuneMatch needs access to your photo library so you can choose a photo to match with music. For example, pick a photo from a concert or a beach walk and TuneMatch analyzes its colors, light and scene to recommend songs that fit that moment.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "14bf2de1-7498-48b4-9f4f-f148e682b06f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/14bf2de1-7498-48b4-9f4f-f148e682b06f"
    }
  }
}
